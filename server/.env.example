# Server port the Express app listens on. Must match VITE_BASE_URL in client/.env
PORT=5500

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/course_hust

# Comma-separated list of origins allowed by CORS (defaults to http://localhost:5173 if unset)
CORS_ORIGIN=http://localhost:5173

# JWT secrets - use long random strings, never reuse across environments
JWT_SECRET_ACCESS_TOKEN=replace-with-a-random-secret
JWT_EXPRIRE_ACCESS_TOKEN=1d
JWT_SECRET_REFRESH_TOKEN=replace-with-a-different-random-secret

# Google Generative AI (chatbot feature)
GOOGLE_AI_API_KEY=replace-with-your-google-ai-key

# Cloudinary (video/document/image storage)
CLOUDINARY_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_KEY=replace-with-your-cloudinary-key
CLOUDINARY_SECRET=replace-with-your-cloudinary-secret

# VNPay payment gateway
# Sandbox vs production is determined entirely by VNPAY_URL + the TMN
# code/secret pair below - never mix a sandbox TMN code with the production
# URL or vice versa.
VNPAY_TMNCODE=replace-with-your-vnpay-tmn-code
VNPAY_SECRETKEY=replace-with-your-vnpay-secret-key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Must be a URL the backend itself serves (VNPAY redirects the customer's
# browser here; the backend verifies the signature before granting anything,
# then redirects on to the frontend's /payment/result page).
VNPAY_RETURNURL=http://localhost:5500/api/vnpay/return
# Server-to-server notification URL. Must be a PUBLIC HTTPS URL VNPAY's
# servers can reach directly - localhost/private URLs cannot receive IPN
# calls at all. Required for production; optional (with a startup warning)
# in local dev, where the return URL above is the only confirmation path.
VNPAY_IPNURL=http://localhost:5500/api/vnpay/ipn
VNPAY_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# SMTP email (forgot-password codes, password-changed notifications, etc.)
# All five of EMAIL_HOST/EMAIL_PORT/EMAIL_USER/EMAIL_PASS/EMAIL_FROM are
# required for real delivery - if any are missing, forgot-password requests
# fail with a controlled 500/502 instead of silently pretending to succeed.
# See helper/mailer.js.
#
# Gmail SMTP: host smtp.gmail.com, port 587, EMAIL_SECURE=false. If the
# Gmail account has 2-Step Verification on (recommended, and required by
# Google for most accounts now), EMAIL_PASS must be a 16-character App
# Password (Google Account -> Security -> App passwords) - NOT the normal
# account password, which SMTP auth will reject.
EMAIL_HOST=replace-with-your-smtp-host
EMAIL_PORT=587
# true for port 465 (implicit TLS), false for port 587/25 (STARTTLS). Leave
# unset to auto-infer from EMAIL_PORT.
EMAIL_SECURE=false
EMAIL_USER=replace-with-your-smtp-user
EMAIL_PASS=replace-with-your-smtp-password
# Must be an address/domain the provider authorizes this account to send as -
# most providers (including Gmail) reject or silently rewrite a From address
# that doesn't match the authenticated account.
EMAIL_FROM=no-reply@example.com
# Optional display name, e.g. "FunCourse" -> "FunCourse <no-reply@example.com>"
EMAIL_FROM_NAME=FunCourse

# Local-dev-only fallback when the EMAIL_* vars above are not set: routes
# mail through a disposable Ethereal test inbox (a real SMTP hop, but NOT the
# real recipient's inbox - only useful for previewing the rendered email).
# Must be explicitly opted into; ignored when NODE_ENV=production. Never set
# this if you're trying to verify delivery to a real email address - set the
# EMAIL_* vars above instead.
EMAIL_DEV_PREVIEW=false
