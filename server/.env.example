# Server port the Express app listens on. Must match VITE_BASE_URL in client/.env
PORT=5500

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/course_hust

# Comma-separated list of origins allowed by CORS (defaults to http://localhost:5173 if unset)
CORS_ORIGIN=http://localhost:5173

# JWT secrets - use long random strings, never reuse across environments
JWT_SECRET_ACCESS_TOKEN=replace-with-a-random-secret
JWT_EXPRIRE_ACCESS_TOKEN=1d
JWT_SECRET_REFRESH_TOKEN=replace-with-a-different-random-secret

# Google Generative AI (chatbot feature)
GOOGLE_AI_API_KEY=replace-with-your-google-ai-key

# Cloudinary (video/document/image storage)
CLOUDINARY_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_KEY=replace-with-your-cloudinary-key
CLOUDINARY_SECRET=replace-with-your-cloudinary-secret

# VNPay payment gateway
# Sandbox vs production is determined entirely by VNPAY_URL + the TMN
# code/secret pair below - never mix a sandbox TMN code with the production
# URL or vice versa.
VNPAY_TMNCODE=replace-with-your-vnpay-tmn-code
VNPAY_SECRETKEY=replace-with-your-vnpay-secret-key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Must be a URL the backend itself serves (VNPAY redirects the customer's
# browser here; the backend verifies the signature before granting anything,
# then redirects on to the frontend's /payment/result page).
VNPAY_RETURNURL=http://localhost:5500/api/vnpay/return
# Server-to-server notification URL. Must be a PUBLIC HTTPS URL VNPAY's
# servers can reach directly - localhost/private URLs cannot receive IPN
# calls at all. Required for production; optional (with a startup warning)
# in local dev, where the return URL above is the only confirmation path.
VNPAY_IPNURL=http://localhost:5500/api/vnpay/ipn
VNPAY_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
